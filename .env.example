# Application
NODE_ENV=development

# API server
PORT=3000
# Defaults to loopback in development and all interfaces in production.
# HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Cloudinary profile and story media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for processing uploaded story videos (public HTTPS API callback URL)
CITEFACE_CLOUDINARY_EAGER_WEBHOOK_URL=

# Stripe marketplace payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
