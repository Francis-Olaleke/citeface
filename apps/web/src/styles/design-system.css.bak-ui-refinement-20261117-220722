/* ==========================================================
   CITEFACE DESIGN SYSTEM v1
   Shared visual foundation — Research. Connect. Discover.
   ========================================================== */

:root {
  color-scheme: light;

  /* Typography */
  --cf-font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --cf-font-display: "Manrope", "Inter", sans-serif;

  --cf-text-xs: 0.75rem;
  --cf-text-sm: 0.875rem;
  --cf-text-base: 1rem;
  --cf-text-lg: 1.125rem;
  --cf-text-xl: 1.375rem;
  --cf-text-2xl: 1.75rem;
  --cf-text-3xl: clamp(2rem, 4vw, 2.75rem);
  --cf-text-4xl: clamp(2.5rem, 5vw, 3.5rem);

  /* Citeface core identity */
  --cf-blue: #2457E6;
  --cf-blue-dark: #173FC2;
  --cf-blue-deep: #142B68;
  --cf-orange: #F27A35;
  --cf-orange-dark: #D85C1D;

  /* Supporting colour family */
  --cf-teal: #119D98;
  --cf-coral: #EF6475;
  --cf-violet: #8065D9;
  --cf-sky: #48A8E8;

  /* Text */
  --cf-ink: #172449;
  --cf-text: #34415F;
  --cf-muted: #687590;
  --cf-subtle: #8994AA;

  /* Surfaces */
  --cf-background: #F4F6FC;
  --cf-surface: #FFFFFF;
  --cf-surface-soft: #F8F9FF;
  --cf-surface-blue: #EDF2FF;
  --cf-surface-orange: #FFF2E9;
  --cf-surface-teal: #E8F8F6;
  --cf-surface-violet: #F2EEFF;

  /* Borders and interaction */
  --cf-border: #E1E7F2;
  --cf-border-strong: #CBD5E7;
  --cf-focus: rgba(36, 87, 230, 0.28);

  /* Elevation */
  --cf-shadow-sm: 0 2px 8px rgba(23, 36, 73, 0.05);
  --cf-shadow-md: 0 10px 30px rgba(23, 36, 73, 0.08);
  --cf-shadow-lg: 0 20px 50px rgba(23, 36, 73, 0.12);

  /* Shape and spacing */
  --cf-radius-sm: 10px;
  --cf-radius-md: 16px;
  --cf-radius-lg: 22px;
  --cf-radius-xl: 28px;
  --cf-radius-pill: 999px;

  --cf-space-1: 4px;
  --cf-space-2: 8px;
  --cf-space-3: 12px;
  --cf-space-4: 16px;
  --cf-space-5: 20px;
  --cf-space-6: 24px;
  --cf-space-8: 32px;
  --cf-space-10: 40px;

  font-family: var(--cf-font-body);
  font-size: 16px;
  color: var(--cf-ink);
  background: var(--cf-background);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  font-family: var(--cf-font-body);
  font-size: var(--cf-text-base);
  line-height: 1.65;
  color: var(--cf-ink);
  background:
    radial-gradient(ellipse at 5% 0%, rgba(36, 87, 230, 0.085), transparent 34%),
    radial-gradient(ellipse at 96% 5%, rgba(242, 122, 53, 0.09), transparent 30%),
    var(--cf-background);
}

#root {
  min-height: 100vh;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--cf-font-display);
  color: var(--cf-ink);
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: -0.035em;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

a {
  text-underline-offset: 3px;
}

::selection {
  color: #FFFFFF;
  background: var(--cf-blue);
}

:focus-visible {
  outline: 3px solid var(--cf-focus);
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}