.story-detail-page {
  min-height: 100vh;
  background: var(--cf-background);
  color: var(--cf-ink);
}

.detail-topbar {
  min-height: 76px;
  padding: 12px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: var(--cf-surface);
  border-bottom: 1px solid var(--cf-border);
}

.detail-brand {
  display: flex;
  flex-direction: column;
  gap: 3px;
  color: var(--cf-blue);
  text-decoration: none;
  font-size: 21px;
  font-weight: 750;
}

.detail-brand small {
  color: var(--cf-subtle);
  font-size: 11px;
  font-weight: 400;
}

.detail-back-link,
.detail-breadcrumb {
  color: var(--cf-blue);
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
}

.detail-back-link:hover,
.detail-breadcrumb:hover {
  text-decoration: underline;
}

.detail-main {
  width: min(100% - 32px, 850px);
  margin: 38px auto 70px;
}

.detail-article,
.detail-state {
  padding: 34px;
  background: var(--cf-surface);
  border: 1px solid var(--cf-border);
  border-radius: var(--cf-radius-md);
  box-shadow: var(--cf-shadow-sm);
}

.detail-breadcrumb {
  display: inline-block;
  margin-bottom: 24px;
}

.detail-classification {
  display: inline-block;
  padding: 6px 11px;
  border-radius: 20px;
  background: var(--cf-surface-blue);
  color: var(--cf-blue-dark);
  font-size: 11px;
  font-weight: 650;
}

.detail-title {
  margin: 18px 0 var(--cf-radius-md);
  color: var(--cf-ink);
  font-size: clamp(27px, 5vw, 3var(--cf-radius-sm));
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.detail-summary {
  margin: 0;
  color: var(--cf-text);
  font-size: 16px;
  line-height: 1.8;
  white-space: pre-line;
}

.detail-byline {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12px;
  margin: 25px 0 30px;
  padding: 18px 0;
  border-top: 1px solid var(--cf-border);
  border-bottom: 1px solid var(--cf-border);
  color: var(--cf-subtle);
  font-size: 12px;
}

.detail-byline div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.detail-byline strong {
  color: var(--cf-ink);
  font-size: var(--cf-radius-md);
}

.detail-section {
  margin-top: 30px;
}

.detail-section h2 {
  margin: 0 0 12px;
  color: var(--cf-ink);
  font-size: 18px;
}

.detail-section > p {
  margin: 0;
  color: var(--cf-text);
  font-size: var(--cf-radius-md);
  line-height: 1.85;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.detail-author-list {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.detail-author-list li {
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: var(--cf-text);
  font-size: 13px;
}

.detail-author-list strong {
  color: var(--cf-ink);
}

.detail-author-list small {
  color: var(--cf-subtle);
}

.detail-topics {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.detail-topics span {
  padding: 7px 11px;
  border: 1px solid var(--cf-border);
  border-radius: 20px;
  color: var(--cf-muted);
  font-size: 12px;
}

.detail-media-list,
.detail-sources {
  display: grid;
  gap: 12px;
}

.detail-media-item,
.detail-source {
  padding: var(--cf-radius-md);
  border: 1px solid var(--cf-border);
  border-radius: var(--cf-radius-sm);
  color: var(--cf-text);
  font-size: 13px;
  overflow-wrap: anywhere;
}

.detail-media-item strong,
.detail-source strong {
  color: var(--cf-ink);
}

.detail-media-item p,
.detail-source p {
  margin: 7px 0;
  line-height: 1.6;
}

.detail-media-item small,
.detail-source small {
  color: var(--cf-subtle);
}

.detail-source a {
  display: inline-block;
  margin-top: var(--cf-radius-sm);
  color: var(--cf-blue);
  font-weight: 600;
}

.detail-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 32px;
  padding-top: 18px;
  border-top: 1px solid var(--cf-border);
  color: var(--cf-subtle);
  font-size: 12px;
}

.detail-state {
  text-align: center;
}

.detail-state h1 {
  margin-top: 0;
  font-size: 23px;
}

.detail-state p {
  color: var(--cf-subtle);
  line-height: 1.7;
}

.detail-state a {
  display: inline-block;
  margin: 10px;
  color: var(--cf-blue);
  font-weight: 600;
}

.detail-state button {
  margin: 10px;
  padding: 10px 16px;
  border: 0;
  border-radius: 8px;
  background: var(--cf-blue);
  color: var(--cf-surface);
  cursor: pointer;
}

@media (max-width: 600px) {
  .detail-topbar {
    padding: 12px 18px;
  }

  .detail-main {
    width: min(100% - 20px, 850px);
    margin-top: 18px;
  }

  .detail-article,
  .detail-state {
    padding: 22px 18px;
  }

  .detail-byline {
    flex-direction: column;
  }
}
.detail-researcher-link {
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: inherit;
  text-decoration: none;
}

.detail-researcher-link strong {
  color: var(--cf-ink);
  font-size: var(--cf-radius-md);
}

.detail-researcher-link span {
  color: var(--cf-subtle);
  font-size: 12px;
}

.detail-researcher-link:hover strong {
  color: var(--cf-blue);
}
